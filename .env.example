# ==============================================================================
# Threadline — Environment Variables
# Copy to .env in project root or backend/.env as required.
# ==============================================================================

# Backend Database (defaults to SQLite: sqlite:///./threadline.db if omitted)
# For production PostgreSQL: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=sqlite:///./threadline.db

# Application Environment: development | production | test
ENVIRONMENT=development

# CORS Allowed Origins for Backend API
# For single local origin (backward compatible):
FRONTEND_URL=http://localhost:5173
# For multiple explicit origins (comma-separated, e.g. production and Vercel preview deploys):
# FRONTEND_URLS=http://localhost:5173,https://threadline.vercel.app,https://threadline-preview.vercel.app

# AI / Knowledge Extraction API Keys (Backend only — NEVER expose via VITE_)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=

# Rate Limiting Configuration
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GENERAL=120
# RATE_LIMIT_EXPENSIVE=15
# TRUSTED_PROXIES=127.0.0.1,10.0.0.1
# REDIS_URL=redis://localhost:6379/0

# Frontend Configuration (Optional: for production deployment e.g. Vercel)
# Local development uses Vite's proxy (/api -> http://127.0.0.1:8000) automatically.
# In production on Vercel, set this to your deployed Render backend URL:
# VITE_API_URL=https://your-backend-app.onrender.com
VITE_API_URL=
